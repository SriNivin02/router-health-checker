# Router Health Checker - Environment Configuration
APP_NAME="Router Health Checker"
APP_ENV=development
SECRET_KEY=change-this-to-a-super-secret-random-key-at-least-32-chars-long
SESSION_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./data/router_health.db

# Host binding: 127.0.0.1 by default for safety. Only change to 0.0.0.0 if "Allow phone access" is enabled.
HOST=127.0.0.1
PORT=8000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_SCAN_PER_MIN=2
RATE_LIMIT_API_PER_MIN=120

# Optional Online AI Assistant (Gemini / OpenAI compatible endpoint)
# If empty, offline knowledge base is used seamlessly
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
